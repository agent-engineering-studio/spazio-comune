# Copiare in .env e personalizzare
BASE_URL=http://localhost:8000
SECRET_KEY=sostituire-con-una-stringa-casuale-di-64-caratteri
UFFICIO_USER=ufficio.sport
UFFICIO_PASSWORD=cambiami
CUSTODE_PASSWORD=custode
FEED_TOKEN=sostituire-token-feed-calendario
TTL_ATTESA_MIN=15
PAYMENT_BACKEND=mock
IDENTITY_BACKEND=mock
COOKIE_SECURE=false

# Server di inferenza: rules (default, offline) | openai (Ollama, vLLM, Azure OpenAI…)
INFERENCE_BACKEND=rules
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=ollama
