# =====================================================================================
#  Spazio Comune – configurazione
# =====================================================================================
#
#  cp .env.example .env            # i valori sotto funzionano subito in locale
#
#  Ogni installazione gestisce UN solo luogo. Un Comune con più luoghi installa una
#  copia del repository (e un .env) per ciascuno.
#
#  Ogni variabile ha una riga "PRODUZIONE:" con il valore da usare quando il Comune
#  mette in esercizio il servizio. Prima di andare online:
#    1. sostituire tutti i valori indicati come PRODUZIONE;
#    2. generare i segreti con   openssl rand -hex 32   (o -base64 24 per le password);
#    3. proteggere il file:      chmod 600 .env   (non va mai nel repository: è in .gitignore);
#       in esercizio i segreti stanno meglio nel vault o nei "secret" della piattaforma.
#  Dopo ogni modifica:  docker compose up -d --force-recreate
#
#  Nota: i commenti vanno su righe proprie; non aggiungere commenti dopo un valore.
# =====================================================================================


# -------------------------------------------------------------------------------------
#  1. IL LUOGO
# -------------------------------------------------------------------------------------

# Nome mostrato su sito, ticket, causale pagoPA e calendario.
# PRODUZIONE: il nome ufficiale del luogo, es. Palestra comunale "Giovanni Paolo II".
SPAZIO_NOME=Campo comunale coperto di via Benagiano

# Indirizzo completo del luogo.
# PRODUZIONE: via, numero civico, CAP, Comune e provincia.
SPAZIO_INDIRIZZO=Via Benagiano, 70023 Gioia del Colle (BA)

# Attività prenotabili, separate da virgola, scelte tra quelle definite in
# app/prenota/catalog.py (calcetto, tennis_singolo, tennis_doppio). Un'attività nuova
# con la sua tariffa si aggiunge lì.
# PRODUZIONE: solo le attività ammesse nel luogo dall'atto dell'ufficio.
SPAZIO_ATTIVITA=calcetto,tennis_singolo,tennis_doppio

# Giorni di apertura (lun,mar,mer,gio,ven,sab,dom) e fascia oraria "apertura-chiusura"
# in ore intere: con 15-22 e slot da 60 minuti il primo slot è alle 15:00, l'ultimo alle 21:00.
# PRODUZIONE: il calendario deciso dall'ufficio; chiusure straordinarie e manutenzioni
# si gestiscono da /ufficio con "Riserva uno slot".
SPAZIO_GIORNI=lun,mar,mer,gio,ven,sab
SPAZIO_ORARIO=15-22

# Durata di uno slot in minuti e quanti giorni in anticipo si può prenotare.
# PRODUZIONE: di norma 60 e 14.
SPAZIO_DURATA_MIN=60
SPAZIO_PREAVVISO_GIORNI=14

# Prefisso dei numeri di prenotazione (es. GDC-7KQ2-M4XP).
# PRODUZIONE: 2-4 lettere che identificano Comune o luogo; da non cambiare dopo l'avvio,
# per non confondere i numeri già emessi.
CODICE_PREFISSO=GDC


# -------------------------------------------------------------------------------------
#  2. IL COMUNE (titolare del trattamento ed ente creditore pagoPA)
# -------------------------------------------------------------------------------------

# PRODUZIONE: denominazione, sede e sito istituzionale dell'ente.
COMUNE_NOME=Comune di Gioia del Colle
COMUNE_INDIRIZZO=Piazza Margherita di Savoia, 10 – 70023 Gioia del Colle (BA)
COMUNE_SITO=https://www.comune.gioiadelcolle.ba.it/

# Ufficio che gestisce il luogo: compare nel back-office, nelle FAQ e nei contatti.
# PRODUZIONE: il nome dell'ufficio competente.
UFFICIO_NOME=Ufficio Cultura, Istruzione e Sport

# Atto che approva le tariffe, citato accanto ai prezzi.
# PRODUZIONE: gli estremi della delibera in vigore.
FONTE_TARIFFE=D.G.C. n. 37/2025 – approvazione tariffe impianti sportivi 2025


# -------------------------------------------------------------------------------------
#  3. APPLICAZIONE E SICUREZZA
# -------------------------------------------------------------------------------------

# Indirizzo pubblico del servizio, senza "/" finale: QR dei ticket, link iCal, ritorno da pagoPA.
# PRODUZIONE: https://prenota.comune.<nome>.<pr>.it (sempre HTTPS, dietro reverse proxy).
BASE_URL=http://localhost:8000

# Firma i cookie di sessione e i QR dei ticket.
# PRODUZIONE: openssl rand -hex 32. Va fissata e non cambiata: se cambia, i QR già emessi
# non sono più validi.
SECRET_KEY=sostituire-con-una-stringa-casuale-di-64-caratteri

# Accesso al back-office /ufficio e alle API /api/v1/ufficio/*.
# PRODUZIONE: un utente nominativo e una password robusta (openssl rand -base64 24).
UFFICIO_USER=ufficio.sport
UFFICIO_PASSWORD=cambiami

# Accesso alla pagina /custode (l'utente è sempre "custode").
# PRODUZIONE: password robusta (openssl rand -base64 18), da consegnare solo al custode.
CUSTODE_PASSWORD=custode

# Token del calendario iCal dell'ufficio (/ufficio/agenda.ics?token=...).
# PRODUZIONE: openssl rand -hex 24, fisso (è nell'URL del calendario sottoscritto);
# chi lo conosce vede gli orari prenotati, va trattato come una password.
FEED_TOKEN=sostituire-token-feed-calendario

# Minuti per cui uno slot resta riservato mentre il cittadino paga.
# PRODUZIONE: 15.
TTL_ATTESA_MIN=15

# Cookie di sessione solo su HTTPS.
# PRODUZIONE: true (obbligatorio). false solo su http://localhost.
COOKIE_SECURE=false

# Pagamenti e identità digitale: nel prototipo esiste solo "mock" (simulazione).
# PRODUZIONE: collegare MyPay SIL (pagoPA, Regione Puglia) e il gateway SPID/CIE dell'ente,
# vedi docs/normativa-it.md; fino ad allora il servizio resta in modalità dimostrativa.
PAYMENT_BACKEND=mock
IDENTITY_BACKEND=mock


# -------------------------------------------------------------------------------------
#  4. INTELLIGENZA ARTIFICIALE
# -------------------------------------------------------------------------------------

# rules  = motore a regole in italiano, offline, deterministico: nessun dato esce dal server.
# openai = LLM compatibile OpenAI (Ollama del profilo "llm", vLLM, Azure OpenAI), con il
#          motore a regole come base e come riserva; i dati personali vengono rimossi prima.
# PRODUZIONE: rules. Passare a openai solo dopo la valutazione d'impatto prevista dalle
# Linee guida AgID, con un LLM interno o un fornitore qualificato ACN.
INFERENCE_BACKEND=rules

# Endpoint, modello e chiave dell'LLM (usati solo con INFERENCE_BACKEND=openai).
# PRODUZIONE con LLM interno: i valori sotto + docker compose --profile llm up -d.
# PRODUZIONE con cloud:       LLM_BASE_URL=https://<risorsa>.openai.azure.com/openai/v1,
#                             LLM_MODEL=<deployment>, LLM_API_KEY=<chiave dal vault>.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=ollama

# Secondi di attesa dell'LLM prima di usare la risposta del motore a regole.
# PRODUZIONE: 20.
LLM_TIMEOUT=20


# -------------------------------------------------------------------------------------
#  5. SERVER MCP (strumenti per altri sistemi agentici, http://localhost:8090/mcp)
# -------------------------------------------------------------------------------------

# Header Host ammessi (protezione da DNS rebinding). La porta è pubblicata solo su 127.0.0.1.
# PRODUZIONE: se l'MCP deve servire agenti su altre macchine, pubblicarlo solo dietro reverse
# proxy con autenticazione e aggiungere qui il nome host del proxy (es. mcp.comune.<nome>.it).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Credenziali dell'ufficio per gli strumenti con i numeri di prenotazione
# (occupazione_slot, dettaglio_prenotazione). Vuote = strumenti disattivati.
# PRODUZIONE: vuote, oppure un utente dedicato solo se un agente dell'ufficio ne ha bisogno.
MCP_UFFICIO_USER=
MCP_UFFICIO_PASSWORD=


# -------------------------------------------------------------------------------------
#  6. ISTANZA DEMO (solo profilo "demo", http://localhost:8001)
# -------------------------------------------------------------------------------------

# Istante di partenza dell'orologio della demo, ora di Roma.
# PRODUZIONE: non usata.
DEMO_ORA=2026-11-09T18:35:00
