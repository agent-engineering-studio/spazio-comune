# =====================================================================================
#  Spazio Comune – configurazione
# =====================================================================================
#
#  cp .env.example .env            # i valori sotto funzionano subito in locale
#
#  Ogni installazione gestisce UN solo luogo. Un Comune con più luoghi installa una
#  copia del repository (e un .env) per ciascuno.
#
#  Ogni variabile ha una riga "PRODUZIONE:" con il valore da usare quando il Comune
#  mette in esercizio il servizio. Prima di andare online:
#    1. sostituire tutti i valori indicati come PRODUZIONE;
#    2. generare i segreti con   openssl rand -hex 32   (o -base64 24 per le password);
#    3. proteggere il file:      chmod 600 .env   (non va mai nel repository: è in .gitignore);
#       in esercizio i segreti stanno meglio nel vault o nei "secret" della piattaforma.
#  Dopo ogni modifica:  docker compose up -d --force-recreate
#
#  Nota: i commenti vanno su righe proprie; non aggiungere commenti dopo un valore.
#
#  BACK-OFFICE /admin: luogo e logo, attività e tariffe (anche per fascia oraria),
#  orari (fasce del regolamento, periodi, festivi, chiusure), pagamenti pagoPA e password del
#  personale si cambiano da lì, senza riavvio. SPID/CIE si configura solo in questo file (3b). I valori di questo file sono quelli iniziali: una sezione
#  salvata dal back-office prevale sul .env (si torna al .env con "Torna ai valori del file .env").
#  Restano solo qui: database, SECRET_KEY, BASE_URL, porte, SPID/CIE, IA, MCP.
# =====================================================================================


# -------------------------------------------------------------------------------------
#  1. IL LUOGO
# -------------------------------------------------------------------------------------

# Nome mostrato su sito, ticket, causale pagoPA e calendario.
# PRODUZIONE: il nome ufficiale del luogo, es. Palestra comunale "Giovanni Paolo II".
SPAZIO_NOME=Campo comunale coperto di via Benagiano

# Indirizzo completo del luogo.
# PRODUZIONE: via, numero civico, CAP, Comune e provincia.
SPAZIO_INDIRIZZO=Via Benagiano, 70023 Gioia del Colle (BA)

# Attività prenotabili, separate da virgola, scelte tra quelle definite in
# app/venue_booking/catalog.py (calcetto, tennis_singolo, tennis_doppio). Un'attività nuova
# con la sua tariffa si aggiunge lì.
# PRODUZIONE: solo le attività ammesse nel luogo dall'atto dell'ufficio.
SPAZIO_ATTIVITA=calcetto,tennis_singolo,tennis_doppio

# Giorni di apertura (lun,mar,mer,gio,ven,sab,dom) e orario "apertura-chiusura" in ore
# intere (chiusura fino a 24): con 15-22 e slot da 60 minuti il primo slot è alle 15:00,
# l'ultimo alle 21:00. Più intervalli separati da virgola lasciano fuori le ore in mezzo,
# per qualsiasi attività: 9-13,14-22 esclude la pausa dalle 13 alle 14.
# Fuori dagli intervalli non esistono slot: senza un intervallo che arrivi a 24 non si
# gioca mai a tarda sera.
# PRODUZIONE: il calendario deciso dall'ufficio; chiusure straordinarie e manutenzioni
# si gestiscono da /ufficio con "Riserva uno slot".
SPAZIO_GIORNI=lun,mar,mer,gio,ven,sab
SPAZIO_ORARIO=15-22

# Orari diversi in alcuni periodi dell'anno, ripetuti ogni anno: GG/MM-GG/MM=orari,
# più periodi separati da punto e virgola. Nel periodo sostituiscono SPAZIO_ORARIO.
# Esempio, estate fino a mezzanotte e orario ridotto a Natale:
#   SPAZIO_ORARIO_PERIODI=01/06-15/09=9-13,16-24;20/12-06/01=15-20
# PRODUZIONE: i periodi previsti dall'atto dell'ufficio; vuoto = stesso orario tutto l'anno.
SPAZIO_ORARIO_PERIODI=

# Giorni festivi ("rossi"): calcolati in automatico ogni anno, senza elenchi da aggiornare
# (Capodanno, Epifania, Pasqua, Lunedì dell'Angelo, 25 aprile, 1° maggio, 2 giugno,
# Ferragosto, 4 ottobre dal 2026, Ognissanti, Immacolata, Natale, Santo Stefano).
#   chiuso  nessuno slot prenotabile (predefinito)
#   aperto  come un giorno normale
#   16-20   orario festivo, con la stessa sintassi di SPAZIO_ORARIO
# Le domeniche si decidono con SPAZIO_GIORNI.
SPAZIO_FESTIVI=chiuso

# Festività locali o chiusure ricorrenti oltre a quelle nazionali: GG/MM (ogni anno)
# o GG/MM/AAAA (solo quell'anno), separate da virgola. Esempio: 26/05,14/08/2027
# PRODUZIONE: almeno la festa del santo patrono.
SPAZIO_FESTIVI_EXTRA=

# Durata di uno slot in minuti e quanti giorni in anticipo si può prenotare.
# PRODUZIONE: di norma 60 e 14.
SPAZIO_DURATA_MIN=60
SPAZIO_PREAVVISO_GIORNI=14

# Prefisso dei numeri di prenotazione (es. GDC-7KQ2-M4XP).
# PRODUZIONE: 2-4 lettere che identificano Comune o luogo; da non cambiare dopo l'avvio,
# per non confondere i numeri già emessi.
CODICE_PREFISSO=GDC


# -------------------------------------------------------------------------------------
#  2. IL COMUNE (titolare del trattamento ed ente creditore pagoPA)
# -------------------------------------------------------------------------------------

# PRODUZIONE: denominazione, sede e sito istituzionale dell'ente.
COMUNE_NOME=Comune di Gioia del Colle
COMUNE_INDIRIZZO=Piazza Margherita di Savoia, 10 – 70023 Gioia del Colle (BA)
COMUNE_SITO=https://www.comune.gioiadelcolle.ba.it/

# Ufficio che gestisce il luogo: compare nel back-office, nelle FAQ e nei contatti.
# PRODUZIONE: il nome dell'ufficio competente.
UFFICIO_NOME=Ufficio Cultura, Istruzione e Sport

# Atto che approva le tariffe, citato accanto ai prezzi.
# PRODUZIONE: gli estremi della delibera in vigore.
FONTE_TARIFFE=D.G.C. n. 37/2025 – approvazione tariffe impianti sportivi 2025


# -------------------------------------------------------------------------------------
#  3. APPLICAZIONE E SICUREZZA
# -------------------------------------------------------------------------------------

# Indirizzo pubblico del servizio, senza "/" finale: QR dei ticket, link iCal, ritorno da pagoPA.
# PRODUZIONE: https://prenota.comune.<nome>.<pr>.it (sempre HTTPS, dietro reverse proxy).
BASE_URL=http://localhost:8000

# Porta dell'app sulla macchina che ospita Docker. Se la 8000 è già occupata, cambiarla qui
# e in BASE_URL. PRODUZIONE: la porta a cui punta il reverse proxy.
APP_PORT=8000

# Firma i cookie di sessione e i QR dei ticket; da essa deriva anche la chiave che cifra nel
# database i segreti inseriti dal back-office (password SIL pagoPA, client secret SPID/CIE).
# PRODUZIONE: openssl rand -hex 32. Va fissata e non cambiata: se cambia, i QR già emessi
# non sono più validi.
SECRET_KEY=sostituire-con-una-stringa-casuale-di-64-caratteri

# Amministratore del back-office delle impostazioni /admin (Basic auth).
# Senza ADMIN_PASSWORD il back-office delle impostazioni resta chiuso.
# La password si può poi cambiare da /admin/access (salvata come hash scrypt):
# da quel momento quella di questo file non vale più.
# PRODUZIONE: un utente nominativo e una password robusta (openssl rand -base64 24).
ADMIN_USER=amministratore
ADMIN_PASSWORD=cambiami-admin

# Accesso al back-office /ufficio e alle API /api/v1/ufficio/*.
# PRODUZIONE: un utente nominativo e una password robusta (openssl rand -base64 24).
UFFICIO_USER=ufficio.sport
UFFICIO_PASSWORD=cambiami

# Accesso alla pagina /custode (l'utente è sempre "custode").
# PRODUZIONE: password robusta (openssl rand -base64 18), da consegnare solo al custode.
CUSTODE_PASSWORD=custode

# Token del calendario iCal dell'ufficio (/ufficio/agenda.ics?token=...).
# PRODUZIONE: openssl rand -hex 24, fisso (è nell'URL del calendario sottoscritto);
# chi lo conosce vede gli orari prenotati, va trattato come una password.
FEED_TOKEN=sostituire-token-feed-calendario

# Minuti per cui uno slot resta riservato mentre il cittadino paga.
# PRODUZIONE: 15.
TTL_ATTESA_MIN=15

# Cookie di sessione solo su HTTPS.
# PRODUZIONE: true (obbligatorio). false solo su http://localhost.
COOKIE_SECURE=false

# Pagamenti pagoPA iniziali: mock = simulazione. L'intermediario (MyPay SIL, Regione Puglia) e le sue
# credenziali si configurano poi dal back-office /admin/payments.
PAYMENT_BACKEND=mock


# -------------------------------------------------------------------------------------
#  3b. ACCESSO DEI CITTADINI CON SPID/CIE (si configura SOLO qui, non dal back-office)
# -------------------------------------------------------------------------------------
#
#  Il servizio si collega via OpenID Connect a un gateway SPID/CIE già accreditato: area
#  personale del portale del Comune, proxy dell'intermediario regionale, Keycloak/SATOSA con i
#  plugin SPID e CIE. Il gestore del gateway fornisce issuer, client id e client secret; a lui si
#  comunica il redirect URI (OIDC_REDIRECT_URI).
#  Dopo una modifica riavviare il servizio. Se una variabile manca o non è valida il servizio non
#  parte e il log dice quale correggere. La pagina /admin/identity mostra i valori in uso
#  (il secret mai) e verifica che il gateway risponda.

# mock = utente di prova (solo demo e test); oidc = gateway SPID/CIE reale.
# PRODUZIONE: oidc.
IDENTITY_BACKEND=mock

# Indirizzo del gateway: da qui si legge <issuer>/.well-known/openid-configuration. Sempre https.
OIDC_ISSUER=

# Credenziali del client, rilasciate dal gestore del gateway. Il secret va trattato come una password.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Indirizzo a cui il gateway rimanda il cittadino dopo l'accesso; va registrato identico presso il
# gestore del gateway. Vuoto = BASE_URL + /auth/oidc/callback. Sempre https (http solo per localhost).
# PRODUZIONE: https://prenota.comune.<nome>.<pr>.it/auth/oidc/callback
OIDC_REDIRECT_URI=

# Attributi richiesti (deve contenere openid) e livello SPID facoltativo, es. https://www.spid.gov.it/SpidL2
OIDC_SCOPE=openid profile email
OIDC_ACR_VALUES=

# Come il client si autentica al token endpoint: client_secret_basic oppure client_secret_post.
OIDC_AUTH_METHOD=client_secret_basic

# Nomi degli attributi (claim) nell'ID token o in userinfo. Il prefisso TINIT- del codice fiscale
# SPID si toglie in automatico. Cambiarli solo se il gateway usa nomi diversi.
OIDC_CLAIM_TAX_CODE=https://attributes.eid.gov.it/fiscal_number
OIDC_CLAIM_NAME=given_name
OIDC_CLAIM_FAMILY_NAME=family_name
OIDC_CLAIM_EMAIL=email


# -------------------------------------------------------------------------------------
#  4. DATABASE (PostgreSQL)
# -------------------------------------------------------------------------------------

# Password dell'utente "spazio" del container spazio-comune-db (PostgreSQL 17, rete interna).
# Usare solo lettere e cifre: compare dentro l'URL di connessione.
# PRODUZIONE: openssl rand -hex 24. Va scelta prima del primo avvio: PostgreSQL la registra
# alla creazione del volume "pgdati" e non la cambia se si modifica questo file.
POSTGRES_PASSWORD=spazio-dev

# Connessione a un PostgreSQL esterno, al posto del container spazio-comune-db.
# Vuoto = si usa il container (postgresql://spazio:<POSTGRES_PASSWORD>@db:5432/spazio_comune).
# PRODUZIONE con servizio gestito su cloud qualificato ACN (backup, cifratura e ripristino
# puntuale inclusi), con TLS obbligatorio:
#   DATABASE_URL=postgresql://<utente>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL=


# -------------------------------------------------------------------------------------
#  5. INTELLIGENZA ARTIFICIALE
# -------------------------------------------------------------------------------------

# rules  = motore a regole in italiano, offline, deterministico: nessun dato esce dal server.
# openai = LLM compatibile OpenAI (Ollama del profilo "llm", vLLM, Azure OpenAI), con il
#          motore a regole come base e come riserva; i dati personali vengono rimossi prima.
# PRODUZIONE: rules. Passare a openai solo dopo la valutazione d'impatto prevista dalle
# Linee guida AgID, con un LLM interno o un fornitore qualificato ACN.
INFERENCE_BACKEND=rules

# Endpoint, modello e chiave dell'LLM (usati solo con INFERENCE_BACKEND=openai).
# PRODUZIONE con LLM interno: i valori sotto + docker compose --profile llm up -d.
# PRODUZIONE con cloud:       LLM_BASE_URL=https://<risorsa>.openai.azure.com/openai/v1,
#                             LLM_MODEL=<deployment>, LLM_API_KEY=<chiave dal vault>.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=ollama

# Secondi di attesa dell'LLM prima di usare la risposta del motore a regole.
# PRODUZIONE: 20.
LLM_TIMEOUT=20


# -------------------------------------------------------------------------------------
#  6. SERVER MCP (strumenti per altri sistemi agentici, http://localhost:8090/mcp)
# -------------------------------------------------------------------------------------

# Header Host ammessi (protezione da DNS rebinding). La porta è pubblicata solo su 127.0.0.1.
# PRODUZIONE: se l'MCP deve servire agenti su altre macchine, pubblicarlo solo dietro reverse
# proxy con autenticazione e aggiungere qui il nome host del proxy (es. mcp.comune.<nome>.it).
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Porta del server MCP sulla macchina che ospita Docker (sempre e solo su 127.0.0.1).
# Se la 8090 è già occupata, cambiarla qui: l'indirizzo diventa http://localhost:<porta>/mcp.
MCP_PORT=8090

# Credenziali dell'ufficio per gli strumenti con i numeri di prenotazione
# (occupazione_slot, dettaglio_prenotazione). Vuote = strumenti disattivati.
# PRODUZIONE: vuote, oppure un utente dedicato solo se un agente dell'ufficio ne ha bisogno.
MCP_UFFICIO_USER=
MCP_UFFICIO_PASSWORD=


# -------------------------------------------------------------------------------------
#  7. ISTANZA DEMO (solo profilo "demo", http://localhost:8001)
# -------------------------------------------------------------------------------------

# Istante di partenza dell'orologio della demo, ora di Roma.
# PRODUZIONE: non usata.
DEMO_ORA=2026-11-09T18:35:00

# Porta dell'istanza demo sulla macchina che ospita Docker.
DEMO_PORT=8001
